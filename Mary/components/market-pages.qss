QWidget[marketPage="true"] QFrame[marketPanel="true"] {
	background: #ffffff;
	border: 1px solid #e4eaf2;
	border-radius: 0;
}
QWidget[marketPage="true"][darkTheme="true"] QFrame[marketPanel="true"] {
	background: #131f32;
	border-color: #24334a;
}
QLabel[marketHeading="true"] {
	font-size: 15px;
	font-weight: 600;
}
QLabel[marketMuted="true"] { color: #68778c; }
QWidget[darkTheme="true"] QLabel[marketMuted="true"] { color: #8c9db6; }
QLabel#priceLabel { font-size: 20px; font-weight: 600; color: #00b987; }
QLabel#priceLabel[rising="true"] { color: #f04455; }
QPushButton#searchButton { padding: 0; font-size: 16px; }
QTabWidget#marketTabs::pane, QTabWidget#periodTabs::pane { border: 0; }
QTabWidget#marketTabs QTabBar::tab { min-width: 65px; height: 20px; padding: 0 10px; }
QSplitter::handle { background: #e4eaf2; }
QWidget[darkTheme="true"] QSplitter::handle { background: #24334a; }
