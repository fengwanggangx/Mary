        <file alias="styles/login.qss">components/login.qss</file>
        <file alias="styles/server-settings.qss">components/server-settings.qss</file>
        <file alias="styles/register.qss">components/register.qss</file>
        <file>images/login.jpg</file>
        <file alias="navigation/ai-trade-white.png">images/ai-trade-white.png</file>
        <file alias="navigation/ai-trade-black.png">images/ai-trade-black.png</file>
        <file alias="navigation/skin-white-white.png">images/skin-white-white.png</file>
        <file alias="navigation/skin-white-black.png">images/skin-white-black.png</file>
        <file alias="navigation/skin-black-white.png">images/skin-black-white.png</file>
        <file alias="navigation/skin-black-black.png">images/skin-black-black.png</file>
        <file alias="navigation/check-white.png">images/check-white.png</file>
        <file alias="navigation/check-black.png">images/check-black.png</file>
        <file alias="branding/mary-app-icon.png">images/mary-app-icon.png</file>
        <file alias="navigation/skin-setting-white.png">images/skin-setting-white.png</file>
        <file alias="navigation/skin-setting-black.png">images/skin-setting-black.png</file>
        <file alias="navigation/hqmarket-white.png">images/hqmarket-white.png</file>
        <file alias="navigation/hqmarket-black.png">images/hqmarket-black.png</file>
        <file alias="navigation/strategy-settings-white.png">images/strategy-settings-white.png</file>
        <file alias="navigation/strategy-settings-black.png">images/strategy-settings-black.png</file>
        <file alias="navigation/risk-setting-white.png">images/risk-setting-white.png</file>
