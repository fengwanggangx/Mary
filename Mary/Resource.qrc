        <file alias="window/max-white.png">images/window-max-white.png</file>
        <file alias="window/restore-white.png">images/window-restore-white.png</file>
        <file alias="window/close-white.png">images/window-close-white.png</file>
        <file alias="window/min-black.png">images/window-min-black.png</file>
        <file alias="window/max-black.png">images/window-max-black.png</file>
        <file alias="window/restore-black.png">images/window-restore-black.png</file>
